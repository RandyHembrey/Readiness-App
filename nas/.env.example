# Copy to .env on the NAS and fill in.
ACME_EMAIL=randy@example.com          # Let's Encrypt expiry notices
RACE_TODO_PASSWORD=change-me-long-passphrase
RACE_TODO_TITLE="USF Pro Championships · Event Readiness"
RACE_TODO_DEMO_DATA=0   # set to 1 for a mock season on first start

# --- Email notifications (race portal weekly reports + daily reminders) ---
# Leave MAIL_FROM empty to keep email off.
MAIL_FROM=races@hembrey.com
MAIL_SENDER_DOMAIN=hembrey.com
# Your mail provider's SMTP submission server and an app password (Google Workspace / Gmail:
# myaccount.google.com/apppasswords on the sending mailbox). Never your normal password.
SMTP_RELAY_HOST=[smtp.gmail.com]:587
SMTP_RELAY_USER=races@hembrey.com
SMTP_RELAY_PASSWORD=
WEEKLY_REPORT_DAY=mon
NOTIFY_HOUR=7
DAILY_REMINDERS=1
TZ=America/New_York
